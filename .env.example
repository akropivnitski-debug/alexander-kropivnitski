# ─── Database (Neon Postgres) ─────────────────────────────────────────────────
# Pooled connection — used by the app at runtime (required)
DATABASE_URL=

# Unpooled connection — used by Payload for schema migrations (required)
# In Neon: Settings > Connection string > select "Connection pooling: off"
DATABASE_URL_UNPOOLED=

# ─── Payload CMS ──────────────────────────────────────────────────────────────
# Random secret used to sign session tokens — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Enable automatic schema push in development ONLY. Never set in production.
# In production, run migrations explicitly via: npx payload migrate
PAYLOAD_DB_PUSH=true

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
