# ─── Database (Neon Postgres) ─────────────────────────────────────────────────
# If using Neon's Vercel integration, these are auto-set as POSTGRES_URL / POSTGRES_URL_NON_POOLING.
# The app will use whichever is available.
#
# Pooled connection — used by the app at runtime
DATABASE_URL=

# Unpooled connection — used by Payload for schema migrations
DATABASE_URL_UNPOOLED=

# ─── Payload CMS ──────────────────────────────────────────────────────────────
# Random secret used to sign session tokens — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Enable automatic schema push in development ONLY. Never set in production.
# In production, run migrations explicitly via: npx payload migrate
PAYLOAD_DB_PUSH=true

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
